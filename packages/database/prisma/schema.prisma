// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Extensions
model Extensions {
  id String @id @default(cuid())
  @@map("_extensions")
}

// Enums
enum QuestionType {
  MULTIPLE_CHOICE
  SINGLE_CHOICE
  TEXT
  RATING
  IMAGE_CHOICE
  BOOLEAN
}

enum QuizStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  SCHEDULED
}

enum SubmissionStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum LogicRuleType {
  SHOW_QUESTION
  HIDE_QUESTION
  JUMP_TO_QUESTION
  SET_VALUE
  SEND_EMAIL
  ADD_TO_CART
}

// Models
model Shop {
  id          String   @id @default(cuid())
  shopifyDomain String  @unique
  accessToken String
  scope       String
  email       String?
  name        String?
  currency    String   @default("USD")
  timezone    String   @default("UTC")
  status      String   @default("active") // active, uninstalled
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  quizzes Quiz[]
  webhookSubscriptions WebhookSubscription[]
  customers Customer[]
  orders Order[]
  products Product[]
  collections Collection[]
  webhookEventLogs WebhookEventLog[]

  @@map("shops")
}

model Quiz {
  id          String     @id @default(cuid())
  shopId      String
  title       String
  description String?
  status      QuizStatus @default(DRAFT)
  settings    Json?      // Quiz configuration settings
  theme       Json?      // UI theme settings
  publishedAt DateTime?
  scheduledAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Relations
  shop        Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  questions   Question[]
  logicRules  LogicRule[]
  submissions Submission[]
  analyticsEvents AnalyticsEvent[]

  @@map("quizzes")
}

model Question {
  id          String      @id @default(cuid())
  quizId      String
  order       Int
  type        QuestionType
  text        String
  description String?
  required    Boolean     @default(false)
  options     Json?       // Question options/choices
  settings    Json?       // Question-specific settings
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // Relations
  quiz        Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  logicRules  LogicRule[]
  answers     Answer[]

  @@map("questions")
}

model LogicRule {
  id          String        @id @default(cuid())
  quizId      String?
  questionId  String?
  type        LogicRuleType
  conditions  Json          // Rule conditions
  actions     Json          // Rule actions
  priority    Int           @default(0)
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // Relations
  quiz        Quiz?         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  question    Question?     @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("logic_rules")
}

model Submission {
  id          String           @id @default(cuid())
  quizId      String
  sessionId   String           @unique
  status      SubmissionStatus @default(IN_PROGRESS)
  metadata    Json?            // Browser, device, location info
  startedAt   DateTime         @default(now())
  completedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  // Relations
  quiz        Quiz             @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers    Answer[]
  analyticsEvents AnalyticsEvent[]

  @@map("submissions")
}

model Answer {
  id           String   @id @default(cuid())
  submissionId String
  questionId   String
  value        Json     // Answer value (can be any type)
  metadata     Json?    // Additional answer metadata
  createdAt    DateTime @default(now())

  // Relations
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  question     Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, questionId])
  @@map("answers")
}

model AnalyticsEvent {
  id          String   @id @default(cuid())
  quizId      String?
  submissionId String?
  eventType   String   // e.g., 'quiz_started', 'question_answered', 'quiz_completed'
  eventData   Json?    // Event-specific data
  metadata    Json?    // Browser, device, location info
  createdAt   DateTime @default(now())

  // Relations
  quiz        Quiz?        @relation(fields: [quizId], references: [id], onDelete: SetNull)
  submission  Submission?  @relation(fields: [submissionId], references: [id], onDelete: SetNull)

  @@map("analytics_events")
}

// Webhook Models
model WebhookSubscription {
  id          String   @id @default(cuid())
  shopId      String
  topic       String
  address     String
  format      String
  version     String
  status      String   @default("active") // active, disabled
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, topic])
  @@map("webhook_subscriptions")
}

model WebhookEventLog {
  id          String   @id @default(cuid())
  shopId      String
  topic       String
  status      String   // processed, failed, unknown_topic
  data        Json?
  errorMessage String?
  requestId   String
  timestamp   DateTime @default(now())

  // Relations
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@map("webhook_event_logs")
}

// Shopify Data Models
model Customer {
  id                String   @id @default(cuid())
  shopifyCustomerId String
  shopId            String
  email             String
  firstName         String?
  lastName          String?
  phone             String?
  tags              String[]
  acceptsMarketing  Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopifyCustomerId, shopId])
  @@map("customers")
}

model Order {
  id                String   @id @default(cuid())
  shopifyOrderId    String
  shopId            String
  orderNumber       String
  totalPrice        String
  currency          String
  customerId        String?
  status            String   @default("pending") // pending, fulfilled, cancelled
  fulfilledAt       DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopifyOrderId, shopId])
  @@map("orders")
}

model Product {
  id                String   @id @default(cuid())
  shopifyProductId  String
  shopId            String
  title             String
  handle            String
  productType       String?
  vendor            String?
  tags              String[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopifyProductId, shopId])
  @@map("products")
}

model Collection {
  id                  String   @id @default(cuid())
  shopifyCollectionId String
  shopId              String
  title               String
  handle              String
  description         String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relations
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopifyCollectionId, shopId])
  @@map("collections")
}

// Indexes for performance
