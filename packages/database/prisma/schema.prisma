// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Extensions
model Extensions {
  @@map("_extensions")
}

// Enums
enum QuestionType {
  MULTIPLE_CHOICE
  SINGLE_CHOICE
  TEXT
  RATING
  IMAGE_CHOICE
  BOOLEAN
}

enum QuizStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  SCHEDULED
}

enum SubmissionStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum LogicRuleType {
  SHOW_QUESTION
  HIDE_QUESTION
  JUMP_TO_QUESTION
  SET_VALUE
  SEND_EMAIL
  ADD_TO_CART
}

// Models
model Shop {
  id          String   @id @default(cuid())
  shopifyDomain String  @unique
  accessToken String
  scope       String
  email       String?
  name        String?
  currency    String   @default("USD")
  timezone    String   @default("UTC")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  quizzes Quiz[]

  @@map("shops")
}

model Quiz {
  id          String     @id @default(cuid())
  shopId      String
  title       String
  description String?
  status      QuizStatus @default(DRAFT)
  settings    Json?      // Quiz configuration settings
  theme       Json?      // UI theme settings
  publishedAt DateTime?
  scheduledAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Relations
  shop        Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  questions   Question[]
  logicRules  LogicRule[]
  submissions Submission[]

  @@map("quizzes")
}

model Question {
  id          String      @id @default(cuid())
  quizId      String
  order       Int
  type        QuestionType
  text        String
  description String?
  required    Boolean     @default(false)
  options     Json?       // Question options/choices
  settings    Json?       // Question-specific settings
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // Relations
  quiz        Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  logicRules  LogicRule[]
  answers     Answer[]

  @@map("questions")
}

model LogicRule {
  id          String        @id @default(cuid())
  quizId      String?
  questionId  String?
  type        LogicRuleType
  conditions  Json          // Rule conditions
  actions     Json          // Rule actions
  priority    Int           @default(0)
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // Relations
  quiz        Quiz?         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  question    Question?     @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("logic_rules")
}

model Submission {
  id          String           @id @default(cuid())
  quizId      String
  sessionId   String           @unique
  status      SubmissionStatus @default(IN_PROGRESS)
  metadata    Json?            // Browser, device, location info
  startedAt   DateTime         @default(now())
  completedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  // Relations
  quiz        Quiz             @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers    Answer[]

  @@map("submissions")
}

model Answer {
  id           String   @id @default(cuid())
  submissionId String
  questionId   String
  value        Json     // Answer value (can be any type)
  metadata     Json?    // Additional answer metadata
  createdAt    DateTime @default(now())

  // Relations
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  question     Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, questionId])
  @@map("answers")
}

model AnalyticsEvent {
  id          String   @id @default(cuid())
  quizId      String?
  submissionId String?
  eventType   String   // e.g., 'quiz_started', 'question_answered', 'quiz_completed'
  eventData   Json?    // Event-specific data
  metadata    Json?    // Browser, device, location info
  createdAt   DateTime @default(now())

  // Relations
  quiz        Quiz?        @relation(fields: [quizId], references: [id], onDelete: SetNull)
  submission  Submission?  @relation(fields: [submissionId], references: [id], onDelete: SetNull)

  @@map("analytics_events")
}

// Indexes for performance
model _prisma_migrations {
  @@map("_prisma_migrations")
}
