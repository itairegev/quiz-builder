# Application Configuration
NODE_ENV=development
PORT=4000

# Database Configuration
DATABASE_URL=postgresql://quiz_user:quiz_password@localhost:5432/shopify_quiz_builder
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=shopify_quiz_builder
DATABASE_USER=quiz_user
DATABASE_PASSWORD=quiz_password

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# Shopify Configuration
SHOPIFY_API_KEY=your_shopify_api_key
SHOPIFY_API_SECRET=your_shopify_api_secret
SHOPIFY_SCOPES=read_products,write_products,read_customers,write_customers,read_orders,write_orders
SHOPIFY_WEBHOOK_SECRET=your_webhook_secret
SHOPIFY_APP_URL=https://your-app-domain.com
SHOPIFY_APP_NAME="Shopify Quiz Builder"

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Third-Party Integrations
KLAVIYO_API_KEY=your_klaviyo_api_key
MAILCHIMP_API_KEY=your_mailchimp_api_key
POSTSCRIPT_API_KEY=your_postscript_api_key
ATTENTIVE_API_KEY=your_attentive_api_key

# Analytics & Tracking
GOOGLE_ANALYTICS_ID=your_ga_id
FACEBOOK_PIXEL_ID=your_fb_pixel_id
TIKTOK_PIXEL_ID=your_tiktok_pixel_id

# AI Service (for content assistance)
AI_SERVICE_API_KEY=your_ai_service_key
AI_SERVICE_URL=https://api.openai.com/v1

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_password

# File Storage
STORAGE_TYPE=local
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your_s3_bucket

# Monitoring & Logging
SENTRY_DSN=your_sentry_dsn
LOG_LEVEL=info
LOG_FORMAT=json

# Development Overrides
SKIP_SHOPIFY_VERIFICATION=false
ENABLE_MOCK_DATA=false
DEBUG_MODE=true
